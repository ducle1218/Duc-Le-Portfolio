{
  "manifest_version": 3,
  "name": "Duc \u2014 Application Helper",
  "version": "1.9.5",
  "description": "Review and fill common application fields using your confirmed Application Studio profile.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ducle1218.github.io/Duc-Le-Portfolio/applications/*",
        "https://ducle1218.github.io/Duc-Le-Portfolio/generator/*",
        "https://ducle1218.github.io/Duc-Le-Portfolio/resume/generator/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Prepare application answers"
  },
  "host_permissions": [
    "https://ducle1218.github.io/*"
  ]
}
