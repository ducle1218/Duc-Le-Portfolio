{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portfolio project source records",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "reviewedOn": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "reviewBasis": {
      "const": "existing-public-portfolio"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^box-\\d+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "enum": [
              "College",
              "High school"
            ]
          },
          "category": {
            "enum": [
              "PERSONAL",
              "STUDENT TEAMS",
              "INTERNSHIPS"
            ]
          },
          "dateLabel": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "completionState": {
            "type": "string",
            "minLength": 1
          },
          "ownership": {
            "type": "object",
            "properties": {
              "individual": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "team": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "notClaimed": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "individual",
              "team",
              "notClaimed"
            ],
            "additionalProperties": false
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "usage": {
                  "type": "string",
                  "minLength": 1
                },
                "owner": {
                  "enum": [
                    "individual",
                    "team",
                    "unclear"
                  ]
                },
                "evidenceIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              },
              "required": [
                "name",
                "usage",
                "owner",
                "evidenceIds"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "owner": {
                  "enum": [
                    "individual",
                    "team",
                    "unclear"
                  ]
                },
                "state": {
                  "enum": [
                    "planned",
                    "modeled",
                    "simulated",
                    "built",
                    "tested",
                    "documented"
                  ]
                },
                "evidenceIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "metrics": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "number"
                      },
                      "unit": {
                        "type": "string",
                        "minLength": 1
                      },
                      "meaning": {
                        "type": "string",
                        "minLength": 1
                      },
                      "conditions": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "value",
                      "unit",
                      "meaning",
                      "conditions"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0
                }
              },
              "required": [
                "id",
                "text",
                "owner",
                "state",
                "evidenceIds",
                "metrics"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "path",
                "quote"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reviewNeeded": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "updatedOn": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "title",
          "stage",
          "category",
          "dateLabel",
          "location",
          "summary",
          "completionState",
          "ownership",
          "tools",
          "claims",
          "evidence",
          "limitations",
          "reviewNeeded",
          "updatedOn"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "reviewedOn",
    "reviewBasis",
    "projects"
  ],
  "additionalProperties": false
}
